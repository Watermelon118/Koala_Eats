{
  "name": "koala-eats-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "customer-web",
    "merchant-web",
    "rider-web",
    "admin-web"
  ],
  "scripts": {
    "mock:server": "node shared/mockApiServer.mjs",
    "dev:customer": "npm run dev -w customer-web -- --host 0.0.0.0 --port 5173",
    "dev:merchant": "npm run dev -w merchant-web -- --host 0.0.0.0 --port 5174",
    "dev:rider": "npm run dev -w rider-web -- --host 0.0.0.0 --port 5175",
    "dev:admin": "npm run dev -w admin-web -- --host 0.0.0.0 --port 5176",
    "build": "npm run build --workspaces",
    "build:customer": "npm run build -w customer-web",
    "build:merchant": "npm run build -w merchant-web",
    "build:rider": "npm run build -w rider-web",
    "build:admin": "npm run build -w admin-web"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^0.561.0",
    "vite": "^8.0.12",
    "typescript": "~6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
